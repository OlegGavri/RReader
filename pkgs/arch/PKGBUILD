# Maintainer: Oleg Gavrilchenko <oleggavrilcenko6@gmail.com>
pkgname=RReader
pkgver=0.2.3
pkgrel=1
pkgdesc="PDF/DJVU/FB reader"
arch=('x86_64')
url="https://github.com/OlegGavri/RReader"
license=('GPL')
depends=('qt5-base' 'poppler-qt5' 'djvulibre')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/OlegGavri/RReader/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

topdir=${pkgname}-${pkgver}

build() {
  cd "$topdir"
  qmake
  make
}

package() {
  cd "$topdir"
  make INSTALL_ROOT="$pkgdir" install
}


